---
import christmasMockup from "../assets/images/promotions/natale-2026-sette-modi.webp";

const { lang = "it" } = Astro.props;
const isEnglish = lang === "en";

const content = isEnglish
  ? {
      label: "Christmas 2026 book promotion",
      eyebrow: "CHRISTMAS 2026 · REVISED EDITION",
      title: "This Christmas, give stories to share together.",
      description: "Seven illustrated Christmas tales to spark wonder, warmth and the joy of reading together.",
      bookTitle: "Sette modi per incontrare Babbo Natale",
      details: "Seven Christmas stories · Italian-language book",
      cta: "Discover the book on Amazon.it",
      close: "Close Christmas promotion",
      imageAlt: "Christmas gift mockup of the revised 2026 edition of Sette modi per incontrare Babbo Natale",
    }
  : {
      label: "Promozione libro di Natale 2026",
      eyebrow: "NATALE 2026 · EDIZIONE RIVEDUTA",
      title: "Questo Natale, regala storie da vivere insieme.",
      description: "Sette racconti illustrati per accendere la meraviglia delle feste e ritagliarsi momenti speciali con i bambini.",
      bookTitle: "Sette modi per incontrare Babbo Natale",
      details: "7 racconti di Natale · Da leggere insieme",
      cta: "Scopri il libro su Amazon",
      close: "Chiudi la promozione natalizia",
      imageAlt: "Mockup natalizio della copertina e del retro di Sette modi per incontrare Babbo Natale, edizione riveduta 2026",
    };
---

<!--
  Campagna limitata fino al 6 gennaio 2027 incluso (ora italiana).
  L'orario e la logica di scadenza sono definiti nel codice client qui sotto:
  dal 7 gennaio 2027, ore 00:00 Europe/Rome, il popup non appare più.
  La chiusura vale per la scheda/sessione corrente, su homepage IT e EN.
-->
<dialog class="christmas-popup" data-christmas-popup aria-label={content.label} aria-labelledby="christmas-popup-title" aria-describedby="christmas-popup-desc">
  <div class="christmas-popup__shell">
    <button class="christmas-popup__close" type="button" data-christmas-close aria-label={content.close} title={content.close}>
      <span aria-hidden="true">×</span>
    </button>
    <a class="christmas-popup__visual" href="https://www.amazon.it/dp/B0FR9LFZLL" target="_blank" rel="noopener noreferrer" aria-label={content.cta}>
      <img
        src={christmasMockup.src}
        alt={content.imageAlt}
        width={christmasMockup.width}
        height={christmasMockup.height}
        decoding="async"
      />
    </a>
    <div class="christmas-popup__body">
      <div class="christmas-popup__copy">
        <span class="christmas-popup__eyebrow">✦ {content.eyebrow}</span>
        <h2 id="christmas-popup-title">{content.title}</h2>
        <p id="christmas-popup-desc" class="christmas-popup__description">{content.description}</p>
        <div class="christmas-popup__divider" aria-hidden="true"></div>
        <p class="christmas-popup__book-title">{content.bookTitle}</p>
        <p class="christmas-popup__details">{content.details}</p>
        <a class="christmas-popup__action" href="https://www.amazon.it/dp/B0FR9LFZLL" target="_blank" rel="noopener noreferrer">
          {content.cta} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</dialog>

<script>
  (() => {
    const popup = document.querySelector<HTMLDialogElement>("[data-christmas-popup]");
    if (!popup || typeof popup.showModal !== "function") return;

    // Ore 00:00 del 7 gennaio 2027 a Roma/Tirana = 23:00 UTC del 6 gennaio.
    // La promozione resta attiva per l'intera giornata del 6 gennaio 2027.
    const expiresAt = Date.parse("2027-01-06T23:00:00.000Z");
    const dismissalKey = "boscofuso-christmas-2026-closed";
    if (Date.now() >= expiresAt) return;

    try {
      if (sessionStorage.getItem(dismissalKey) === "1") return;
    } catch {
      // Il popup resta utilizzabile anche quando lo storage è bloccato.
    }

    const previouslyFocused = document.activeElement;
    const priorBodyOverflow = document.body.style.overflow;
    const closeButton = popup.querySelector<HTMLButtonElement>("[data-christmas-close]");

    const expireTimer = window.setInterval(() => {
      if (Date.now() >= expiresAt) popup.close();
    }, 60_000);

    popup.addEventListener("close", () => {
      clearInterval(expireTimer);
      document.body.style.overflow = priorBodyOverflow;
      try { sessionStorage.setItem(dismissalKey, "1"); } catch { /* storage non disponibile */ }
      if (previouslyFocused instanceof HTMLElement) previouslyFocused.focus({ preventScroll: true });
    }, { once: true });

    closeButton?.addEventListener("click", () => popup.close());
    popup.addEventListener("click", (event) => {
      if (event.target === popup) popup.close();
    });

    document.body.style.overflow = "hidden";
    popup.showModal();
    closeButton?.focus({ preventScroll: true });
  })();
</script>

<style>
  .christmas-popup {
    width: min(960px, calc(100vw - 40px));
    max-width: none;
    max-height: min(640px, calc(100dvh - 40px));
    padding: 0;
    margin: auto;
    border: 1px solid rgba(242, 203, 128, 0.38);
    border-radius: 20px;
    background: #fffaf1;
    color: #302921;
    box-shadow: 0 24px 90px rgba(6, 18, 12, 0.5);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .christmas-popup::backdrop {
    background: rgba(7, 20, 16, 0.72);
    backdrop-filter: blur(4px);
  }
  .christmas-popup__shell {
    position: relative;
    display: grid;
    grid-template-columns: 47% 53%;
    min-height: 420px;
  }
  .christmas-popup__visual {
    display: block;
    min-width: 0;
    position: relative;
    overflow: hidden;
    background: #361b17;
  }
  .christmas-popup__visual img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: block;
    object-fit: cover;
    object-position: center;
  }
  .christmas-popup__body {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(32px, 4.7vw, 54px);
    background: radial-gradient(circle at 100% 0, #fffaf0 0, #f7ecdc 58%, #f4e6d3 100%);
  }
  .christmas-popup__copy { width: 100%; }
  .christmas-popup__eyebrow {
    display: inline-block;
    color: #8d2330;
    font-size: 0.75rem;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .christmas-popup h2 {
    margin: 13px 0 16px;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1.14;
    color: #153e2a;
    text-wrap: balance;
  }
  .christmas-popup__description {
    margin: 0;
    color: #514a41;
    font-size: clamp(0.97rem, 1.5vw, 1.09rem);
    line-height: 1.5;
  }
  .christmas-popup__divider {
    width: 65px;
    height: 2px;
    margin: 20px 0 15px;
    background: #bd9d5f;
  }
  .christmas-popup__book-title {
    margin: 0;
    color: #80202a;
    font-weight: 800;
    line-height: 1.3;
    font-size: 1rem;
  }
  .christmas-popup__details {
    margin: 4px 0 22px;
    color: #655d51;
    line-height: 1.35;
    font-size: 0.85rem;
  }
  .christmas-popup__action {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    min-height: 48px;
    padding: 11px 22px;
    border-radius: 8px;
    background: #9b2030;
    color: #fff;
    font-weight: 800;
    font-size: 0.94rem;
    text-align: center;
    line-height: 1.3;
    text-decoration: none;
    box-shadow: 0 5px 12px rgba(119, 26, 37, 0.18);
    transition: background-color 180ms ease;
  }
  .christmas-popup__action:hover { background: #7d1523; }
  .christmas-popup__action:focus-visible,
  .christmas-popup__visual:focus-visible,
  .christmas-popup__close:focus-visible {
    outline: 3px solid #b48939;
    outline-offset: 4px;
  }
  .christmas-popup__close {
    position: absolute;
    top: 13px;
    right: 13px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(30, 45, 32, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    color: #233e31;
    font: 28px/1 Arial, sans-serif;
    cursor: pointer;
  }
  .christmas-popup__close:hover { background: white; }
  @media (max-width: 720px) {
    .christmas-popup {
      width: min(460px, calc(100vw - 24px));
      max-height: calc(100dvh - 24px);
      border-radius: 15px;
    }
    .christmas-popup__shell { display: block; min-height: 0; }
    .christmas-popup__visual { height: clamp(160px, 35dvh, 245px); }
    .christmas-popup__visual img {
      height: 100%;
      min-height: 0;
      object-position: center 46%;
    }
    .christmas-popup__body { padding: 22px 25px 26px; }
    .christmas-popup__close { top: 10px; right: 10px; background: #fffaf4; }
    .christmas-popup h2 { font-size: clamp(1.5rem, 6.3vw, 2rem); margin: 8px 0 9px; }
    .christmas-popup__description { font-size: 0.94rem; }
    .christmas-popup__divider { margin: 12px 0; }
    .christmas-popup__details { margin-bottom: 14px; }
    .christmas-popup__action { width: 100%; padding: 11px 14px; }
  }
  @media (max-width: 720px) and (max-height: 650px) {
    .christmas-popup__visual { height: 140px; }
    .christmas-popup__body { padding-top: 18px; padding-bottom: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .christmas-popup__action { transition: none; }
  }
</style>
