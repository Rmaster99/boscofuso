---
import { Image } from "astro:assets";
import boscofusoLogo from "../assets/images/brand/boscofuso-logo.png";

const { lang = "it" } = Astro.props;

const t = lang === "en"
  ? {
      home: "HOME",
      books: "Books",
      world: "Boscofuso world",
      play: "Play",
      coloring: "Coloring",
      printPlay: "Print and Play",
      cleverDen: "The den of clever tricks",
      comingSoon: "Coming soon",
      characters: "Characters",
      projects: "Other projects",
      otherBooks: "Happy Edy",
      paroleDiSeta: "Parole di Seta",
      navLabel: "Main navigation",
      languageLabel: "Choose language",
      menuOpenLabel: "Open menu",
      menuCloseLabel: "Close menu",
    }
  : {
      home: "HOME",
      books: "Libri",
      world: "Il mondo di Boscofuso",
      play: "Gioca",
      coloring: "Da colorare",
      printPlay: "Stampa e gioca",
      cleverDen: "La tana delle astuzie",
      comingSoon: "Prossimamente",
      characters: "I personaggi",
      projects: "Altri progetti",
      otherBooks: "Happy Edy",
      paroleDiSeta: "Parole di Seta",
      navLabel: "Navigazione principale",
      languageLabel: "Scegli lingua",
      menuOpenLabel: "Apri menu",
      menuCloseLabel: "Chiudi menu",
    };

const base = `/${lang}`;
const pathname = Astro.url.pathname;
const isHappyEdy = pathname.includes("/happy-edy");
const brandLogo = boscofusoLogo;
const brandAlt = "Boscofuso";
const brandHref = `${base}/`;

function languageUrl(targetLang) {
  if (targetLang === "it") {
    if (pathname.startsWith("/en/books/")) return pathname.replace("/en/books/", "/it/libri/");
    if (pathname.startsWith("/en/print-and-play/")) return "/it/stampa-e-gioca/";
    if (pathname.startsWith("/en/")) return pathname.replace("/en/", "/it/");
    return "/it/";
  }

  if (pathname.startsWith("/it/libri/")) return pathname.replace("/it/libri/", "/en/books/");
  if (pathname.startsWith("/it/stampa-e-gioca/")) return "/en/print-and-play/";
  if (pathname.startsWith("/it/")) return pathname.replace("/it/", "/en/");
  return "/en/";
}
---

<header class={`site-header ${isHappyEdy ? "site-header--happy" : ""}`}>
  <a class="site-brand" href={brandHref} aria-label={lang === "en" ? "Boscofuso home" : "Home Boscofuso"}>
    <Image
      src={brandLogo}
      alt={brandAlt}
      class="site-brand__logo"
      widths={[114, 125, 138, 169, 228, 250, 276, 338, 507]}
      sizes="(max-width: 420px) 114px, (max-width: 768px) 125px, (max-width: 980px) 138px, 169px"
      format="webp"
      quality={90}
      loading="eager"
    />
  </a>

  <nav class="site-nav" id="site-nav" aria-label={t.navLabel} data-site-nav>
    <a href={`${base}/`}>{t.home}</a>
    <a href={lang === "en" ? "/en/books/" : "/it/libri/"}>{t.books}</a>
    <a href={`${base}/mondo-di-boscofuso/`}>{t.world}</a>
    <a href={`${base}/personaggi/`}>{t.characters}</a>

    <div class="site-nav__group" data-nav-group>
      <button
        class="site-nav__group-trigger"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        data-nav-group-trigger
      >
        <span>{t.play}</span>
        <span class="site-nav__group-chevron" aria-hidden="true"></span>
      </button>

      <div class="site-nav__submenu" data-nav-group-menu>
        <a href={`${base}/da-colorare/`}>{t.coloring}</a>
        <a href={lang === "en" ? "/en/print-and-play/" : "/it/stampa-e-gioca/"}>
          {t.printPlay}
        </a>
        <span class="site-nav__submenu-disabled" aria-disabled="true">
          <span>{t.cleverDen}</span>
          <small>{t.comingSoon}</small>
        </span>
      </div>
    </div>

    <div class="site-nav__group" data-nav-group>
      <button
        class="site-nav__group-trigger"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        data-nav-group-trigger
      >
        <span>{t.projects}</span>
        <span class="site-nav__group-chevron" aria-hidden="true"></span>
      </button>

      <div class="site-nav__submenu site-nav__submenu--projects" data-nav-group-menu>
        <a class="site-nav__project-link site-nav__project-link--happy" href={`${base}/happy-edy/`}>
          {t.otherBooks}
        </a>
        <a class="site-nav__project-link site-nav__project-link--parole" href={`${base}/parole-di-seta/`}>
          {t.paroleDiSeta}
        </a>
      </div>
    </div>
  </nav>

  <div class="langx" data-langx>
    <button
      class="langx__trigger"
      type="button"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label={t.languageLabel}
      data-langx-trigger
    >
      <span class={`langx__flag langx__flag--${lang}`} aria-hidden="true"></span>
      <span class="langx__code">{lang.toUpperCase()}</span>
      <span class="langx__chevron" aria-hidden="true"></span>
    </button>

    <div class="langx__menu" data-langx-menu>
      <a
        class={`langx__item ${lang === "it" ? "is-active" : ""}`}
        href={languageUrl("it")}
        hreflang="it"
      >
        <span class="langx__flag langx__flag--it" aria-hidden="true"></span>
        <span>IT</span>
      </a>

      <a
        class={`langx__item ${lang === "en" ? "is-active" : ""}`}
        href={languageUrl("en")}
        hreflang="en"
      >
        <span class="langx__flag langx__flag--en" aria-hidden="true"></span>
        <span>EN</span>
      </a>
    </div>
  </div>

  <button
    class="mobile-menu-toggle"
    type="button"
    aria-controls="site-nav"
    aria-expanded="false"
    aria-label={t.menuOpenLabel}
    data-mobile-menu-toggle
    data-open-label={t.menuOpenLabel}
    data-close-label={t.menuCloseLabel}
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<script>
  function initHeaderControls() {
    const closeNavGroups = (scope = document) => {
      scope.querySelectorAll("[data-nav-group]").forEach((group) => {
        group.classList.remove("is-open");
        group.querySelector("[data-nav-group-trigger]")?.setAttribute("aria-expanded", "false");
      });
    };

    /* PLAY SUBMENU */
    document.querySelectorAll("[data-nav-group]").forEach((group) => {
      if (group.dataset.ready === "1") return;
      group.dataset.ready = "1";

      const trigger = group.querySelector("[data-nav-group-trigger]");
      if (!trigger) return;

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const wasOpen = group.classList.contains("is-open");
        closeNavGroups(document);
        group.classList.toggle("is-open", !wasOpen);
        trigger.setAttribute("aria-expanded", wasOpen ? "false" : "true");
      });

      group.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        group.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      });
    });

    /* LANGUAGE */
    document.querySelectorAll("[data-langx]").forEach((root) => {
      if (root.dataset.ready === "1") return;
      root.dataset.ready = "1";

      const trigger = root.querySelector("[data-langx-trigger]");
      const menu = root.querySelector("[data-langx-menu]");
      if (!trigger || !menu) return;

      const closeLang = () => {
        root.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
      };

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = root.classList.toggle("is-open");
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (!root.contains(target)) closeLang();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeLang();
      });
    });

    /* MOBILE MENU */
    document.querySelectorAll(".site-header").forEach((siteHeader) => {
      if (siteHeader.dataset.mobileReady === "1") return;
      siteHeader.dataset.mobileReady = "1";

      const toggle = siteHeader.querySelector("[data-mobile-menu-toggle]");
      const nav = siteHeader.querySelector("[data-site-nav]");
      if (!toggle || !nav) return;

      const openLabel = toggle.dataset.openLabel || "Open menu";
      const closeLabel = toggle.dataset.closeLabel || "Close menu";

      const closeMenu = () => {
        siteHeader.classList.remove("mobile-menu-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", openLabel);
        closeNavGroups(siteHeader);
      };

      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = siteHeader.classList.toggle("mobile-menu-open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
      });

      nav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (!siteHeader.contains(target)) closeMenu();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 768) closeMenu();
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!target.parentElement?.closest("[data-nav-group]")) closeNavGroups(document);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderControls, { once: true });
  } else {
    initHeaderControls();
  }

  document.addEventListener("astro:page-load", initHeaderControls);
</script>

<style>
  .langx {
    position: relative;
    flex: 0 0 auto;
    margin-left: 0.8rem;
    z-index: 200;
  }

  .langx__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    height: 38px;
    padding: 0 0.8rem 0 0.45rem;

    border: 1px solid rgba(251, 244, 228, 0.22);
    border-radius: 999px;

    background: rgba(255, 255, 255, 0.08);
    color: #fbf4e4;

    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;

    cursor: pointer;
  }

  .langx__trigger:hover,
  .langx__trigger:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: #d9a92f;
    outline: none;
  }

  .langx__flag {
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(255,255,255,.25);
  }

  .langx__flag--it {
    background: linear-gradient(
      90deg,
      #009246 0 33.333%,
      #ffffff 33.333% 66.666%,
      #ce2b37 66.666% 100%
    );
  }

  .langx__flag--en {
    background:
      linear-gradient(33deg, transparent 42%, #fff 42% 47%, #c8102e 47% 53%, #fff 53% 58%, transparent 58%),
      linear-gradient(-33deg, transparent 42%, #fff 42% 47%, #c8102e 47% 53%, #fff 53% 58%, transparent 58%),
      linear-gradient(90deg, transparent 40%, #fff 40% 60%, transparent 60%),
      linear-gradient(0deg, transparent 40%, #fff 40% 60%, transparent 60%),
      linear-gradient(90deg, transparent 45%, #c8102e 45% 55%, transparent 55%),
      linear-gradient(0deg, transparent 45%, #c8102e 45% 55%, transparent 55%),
      #012169;
  }

  .langx__code {
    min-width: 18px;
    text-align: center;
  }

  .langx__chevron {
    width: 8px;
    height: 8px;
    margin-left: 0.05rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 160ms ease;
  }

  .langx.is-open .langx__chevron {
    transform: rotate(225deg) translate(-1px, -1px);
  }

  .langx__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;

    display: none;
    min-width: 104px;
    padding: 6px;

    border: 1px solid rgba(251,244,228,.14);
    border-radius: 12px;

    background: #0a2f1e;
    box-shadow: 0 14px 34px rgba(0,0,0,.28);
  }

  .langx.is-open .langx__menu {
    display: grid;
    gap: 3px;
  }

  .langx__item {
    display: flex;
    align-items: center;
    gap: 0.55rem;

    padding: 0.45rem 0.55rem;
    border-radius: 8px;

    color: #fbf4e4;
    text-decoration: none;

    font-size: 0.78rem;
    font-weight: 700;
  }

  .langx__item:hover,
  .langx__item:focus-visible {
    background: rgba(255,255,255,.08);
    color: #d9a92f;
    outline: none;
  }

  .langx__item.is-active {
    background: rgba(217,169,47,.11);
  }

  .langx__item .langx__flag {
    width: 22px;
    height: 22px;
    flex-basis: 22px;
  }

  /* HAPPY EDY - logo e controlli header */

  .site-header--happy .langx__menu {
    background: #293E4F;
  }

  .site-header--happy .langx__trigger:hover,
  .site-header--happy .langx__trigger:focus-visible {
    border-color: rgba(255, 255, 255, 0.65);
  }

  .site-header--happy .langx__item:hover,
  .site-header--happy .langx__item:focus-visible {
    color: #ffffff;
  }

  .site-header--happy .langx__item.is-active {
    background: rgba(255, 255, 255, 0.10);
  }

  @media (max-width: 980px) {
    .langx {
      margin-left: auto;
    }
  }


  /* ==================================================
     MOBILE HEADER - OVERRIDE DEFINITIVO
     Nasconde SEMPRE il menu desktop sotto 768px.
     ================================================== */

  .mobile-menu-toggle {
    display: none;
  }

  /* GIOCA / PLAY - menu a discesa */

  .site-nav__group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-nav__group-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: inherit;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }

  .site-nav__group-trigger:hover,
  .site-nav__group-trigger:focus-visible {
    color: var(--bf-gold);
    outline: none;
  }

  .site-nav__group-chevron {
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 160ms ease;
  }

  .site-nav__group.is-open .site-nav__group-chevron {
    margin-top: 3px;
    transform: rotate(225deg);
  }

  .site-nav__submenu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 220;
    display: none;
    width: max-content;
    min-width: 250px;
    padding: 0.5rem;
    border: 1px solid rgba(251, 244, 228, 0.14);
    border-radius: 14px;
    background: #0a2f1e;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
    transform: translateX(-50%);
  }

  .site-nav__submenu::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 12px;
  }

  .site-nav__group.is-open .site-nav__submenu {
    display: grid;
    gap: 0.15rem;
  }

  .site-nav__submenu a,
  .site-nav__submenu-disabled {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.7rem 0.8rem;
    border-radius: 9px;
    font-size: 0.83rem !important;
    font-weight: 700;
    line-height: 1.25;
    text-transform: none !important;
    white-space: nowrap;
  }

  .site-nav__submenu a:hover,
  .site-nav__submenu a:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .site-nav__submenu-disabled {
    color: rgba(251, 244, 228, 0.66);
    cursor: default;
  }

  .site-nav__submenu-disabled small {
    color: var(--bf-gold);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .site-nav__project-link {
    justify-content: flex-start !important;
  }

  .site-nav__project-link::before {
    content: "";
    width: 8px;
    height: 8px;
    flex: 0 0 8px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.07);
  }

  .site-nav__project-link--happy {
    color: #dfc9ea;
  }

  .site-nav__project-link--parole {
    color: #8edbd3;
  }

  .site-nav__project-link--happy:hover,
  .site-nav__project-link--happy:focus-visible {
    color: #f0ddf7 !important;
  }

  .site-nav__project-link--parole:hover,
  .site-nav__project-link--parole:focus-visible {
    color: #b6eee8 !important;
  }

  .site-header--happy .site-nav__submenu {
    background: #293E4F;
  }

  @media (hover: hover) and (min-width: 769px) {
    .site-nav__group:hover .site-nav__submenu {
      display: grid;
      gap: 0.15rem;
    }
  }

  @media (max-width: 768px) {
    .site-header {
      position: relative;
      flex-wrap: nowrap !important;
      min-height: 82px !important;
      padding: 0.6rem 1rem !important;
      gap: 0.65rem !important;
    }

    .site-brand {
      order: 1;
      flex: 0 0 auto;
    }

    .site-brand__logo {
      width: 125px !important;
    }


    .langx {
      order: 2;
      margin-left: auto !important;
    }

    .mobile-menu-toggle {
      order: 3;
      display: grid !important;
      place-items: center;
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      padding: 9px;
      border: 1px solid rgba(251, 244, 228, 0.22);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      color: #fbf4e4;
      cursor: pointer;
    }

    .mobile-menu-toggle span {
      display: block;
      width: 21px;
      height: 2px;
      margin: 2.5px 0;
      border-radius: 999px;
      background: currentColor;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    .site-header .site-nav {
      position: absolute !important;
      top: 100% !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 190 !important;

      display: none !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0.75rem 1rem 1rem !important;

      flex-direction: column !important;
      align-items: stretch !important;
      justify-content: flex-start !important;
      gap: 0 !important;

      max-height: calc(100dvh - 82px);
      overflow-x: hidden !important;
      overflow-y: auto !important;
      background: #0a2f1e !important;
      border-top: 1px solid rgba(251, 244, 228, 0.10);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.24);
    }

    .site-header.mobile-menu-open .site-nav {
      display: flex !important;
    }

    .site-header--happy .site-nav {
      background: #293E4F !important;
    }

    .site-header .site-nav a {
      display: block;
      padding: 0.8rem 0.25rem;
      border-bottom: 1px solid rgba(251, 244, 228, 0.09);
      font-size: 0.82rem !important;
      white-space: normal;
    }

    .site-header .site-nav a:last-child {
      border-bottom: 0;
    }

    .site-header .site-nav__group {
      display: block;
      width: 100%;
    }

    .site-header .site-nav__group-trigger {
      justify-content: space-between;
      width: 100%;
      padding: 0.8rem 0.25rem;
      border-bottom: 1px solid rgba(251, 244, 228, 0.09);
      font-size: 0.82rem;
      text-align: left;
    }

    .site-header .site-nav__submenu {
      position: static;
      width: 100%;
      min-width: 0;
      padding: 0.25rem 0 0.45rem 0.75rem;
      border: 0;
      border-bottom: 1px solid rgba(251, 244, 228, 0.09);
      border-radius: 0;
      background: rgba(255, 255, 255, 0.035);
      box-shadow: none;
      transform: none;
    }

    .site-header .site-nav__submenu::before {
      display: none;
    }

    .site-header .site-nav__submenu a,
    .site-header .site-nav__submenu-disabled {
      padding: 0.7rem 0.65rem;
      border-bottom: 1px solid rgba(251, 244, 228, 0.06);
      border-radius: 0;
      font-size: 0.78rem !important;
      white-space: normal;
    }

    .site-header .site-nav__submenu > :last-child {
      border-bottom: 0;
    }

    .site-header.mobile-menu-open .mobile-menu-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .site-header.mobile-menu-open .mobile-menu-toggle span:nth-child(2) {
      opacity: 0;
    }

    .site-header.mobile-menu-open .mobile-menu-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  @media (max-width: 420px) {
    .site-header {
      padding-inline: 0.75rem !important;
    }

    .site-brand__logo {
      width: 114px !important;
    }


    .langx__trigger {
      height: 36px;
    }
  }
</style>
