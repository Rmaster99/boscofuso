const books = lang === "en" ? booksEn : booksIt;

const t = lang === "en"
  ? {
      title: "Happy Edy books",
      intro: "Stories, journals and books created to accompany imagination, emotions and special moments.",
      amazon: "Buy on Amazon",
      kobo: "Buy on Kobo",
      galleryAlt: "Book preview",
    }
  : {
      title: "I libri di Happy Edy",
      intro: "Storie, diari e libri pensati per accompagnare fantasia, emozioni e momenti speciali.",
      amazon: "Acquista su Amazon",
      kobo: "Acquista su Kobo",
      galleryAlt: "Anteprima del libro",
    };
---

<section class="happy-books page-shell">
  <header class="happy-books__header">
    <div class="happy-books__identity">
      <Image
        src={happyEdyLogo}
        alt="Happy Edy"
        class="happy-books__logo"
        loading="eager"
      />
      <h1>{t.title}</h1>
    </div>
    <p>{t.intro}</p>
  </header>

  <div class="happy-books__list">
    {books.map((book, index) => (
      <article class="happy-book" id={book.id}>
        <div class="happy-book__main">
          <div class="happy-book__cover-wrap">
            <Image
              src={book.cover}
              alt={book.title}
              class="happy-book__cover"
              widths={[320, 480, 640, 800]}
              sizes="(max-width: 760px) 70vw, 320px"
              loading={index === 0 ? "eager" : "lazy"}
            />

            <div class="happy-book__actions">
              {book.amazon && (
                <a class="happy-book__button" href={book.amazon} target="_blank" rel="noopener noreferrer">{t.amazon}</a>
              )}

              {book.kobo && (
                <a class="happy-book__button happy-book__button--secondary" href={book.kobo} target="_blank" rel="noopener noreferrer">{t.kobo}</a>
              )}
            </div>
          </div>

          <div class="happy-book__copy">
            <div class="happy-book__title-row">
              <h2>{book.title}</h2>

              {lang === "it" && ["libro-04", "libro-05", "libro-06", "libro-07", "libro-08"].includes(book.id) && (
                <svg
                  class="happy-book__language-flag"
                  viewBox="0 0 60 36"
                  role="img"
                  aria-label="Edizione in inglese"
                >
                  <defs>
                    <clipPath id={`uk-wave-${book.id}`}>
                      <path d="M1 3 C12 -1 22 5 34 2 C44 0 52 5 59 2 L58 33 C49 36 39 31 29 34 C18 37 9 31 1 34 Z" />
                    </clipPath>
                  </defs>

                  <g clip-path={`url(#uk-wave-${book.id})`}>
                    <rect width="60" height="36" fill="#012169" />

                    <path d="M0 0 L60 36 M60 0 L0 36"
                      stroke="#FFFFFF"
                      stroke-width="9"
                    />
                    <path d="M0 0 L60 36 M60 0 L0 36"
                      stroke="#C8102E"
                      stroke-width="4"
                    />

                    <path d="M30 0 V36 M0 18 H60"
                      stroke="#FFFFFF"
                      stroke-width="12"
                    />
                    <path d="M30 0 V36 M0 18 H60"
                      stroke="#C8102E"
                      stroke-width="7"
                    />
                  </g>

                  <path
                    d="M1 3 C12 -1 22 5 34 2 C44 0 52 5 59 2 L58 33 C49 36 39 31 29 34 C18 37 9 31 1 34 Z"
                    fill="none"
                    stroke="rgba(0,0,0,0.14)"
                    stroke-width="0.8"
                  />
                </svg>
              )}

              {lang === "en" && index <= 2 && (
                <svg
                  class="happy-book__language-flag"
                  viewBox="0 0 60 36"
                  role="img"
                  aria-label="Italian edition"
                >
                  <defs>
                    <clipPath id={`it-wave-${book.id}`}>
                      <path d="M1 3 C12 -1 22 5 34 2 C44 0 52 5 59 2 L58 33 C49 36 39 31 29 34 C18 37 9 31 1 34 Z" />
                    </clipPath>
                  </defs>

                  <g clip-path={`url(#it-wave-${book.id})`}>
                    <rect x="0" y="0" width="20" height="36" fill="#009246" />
                    <rect x="20" y="0" width="20" height="36" fill="#FFFFFF" />
                    <rect x="40" y="0" width="20" height="36" fill="#CE2B37" />
                  </g>

                  <path
                    d="M1 3 C12 -1 22 5 34 2 C44 0 52 5 59 2 L58 33 C49 36 39 31 29 34 C18 37 9 31 1 34 Z"
                    fill="none"
                    stroke="rgba(0,0,0,0.14)"
                    stroke-width="0.8"
                  />
                </svg>
              )}
            </div>

            <p>{book.description}</p>
          </div>
        </div>

        <div class="happy-book__gallery" aria-label={`${t.galleryAlt}: ${book.title}`}>
          {book.gallery.map((image, imageIndex) => (
            <div class="happy-book__gallery-item">
              <Image
                src={image}
                alt={`${t.galleryAlt} ${imageIndex + 1}: ${book.title}`}
                class="happy-book__gallery-image"
                widths={[480, 720, 1000, 1400]}
                sizes="(max-width: 760px) 100vw, 33vw"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
