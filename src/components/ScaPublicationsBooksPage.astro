---
import { Image } from "astro:assets";
import logo from "../assets/images/brand/sca-publications-logo.svg";
import cover01 from "../assets/images/sca-publications/books/libro-01/copertina.webp";
import photo011 from "../assets/images/sca-publications/books/libro-01/foto-01.webp";
import photo012 from "../assets/images/sca-publications/books/libro-01/foto-02.webp";
import photo013 from "../assets/images/sca-publications/books/libro-01/foto-03.webp";
import cover02 from "../assets/images/sca-publications/books/libro-02/copertina.webp";
import photo021 from "../assets/images/sca-publications/books/libro-02/foto-01.webp";
import photo022 from "../assets/images/sca-publications/books/libro-02/foto-02.webp";
import photo023 from "../assets/images/sca-publications/books/libro-02/foto-03.webp";
const { lang = "it" } = Astro.props;
const booksIt=[
{id:"libro-01",title:"LEED Green Associate – Study Booklet",description:`Un manuale di studio dedicato alla preparazione dell’esame LEED Green Associate, organizzato per offrire una lettura chiara e strutturata dei principi, delle strategie e degli strumenti legati all’edilizia sostenibile.\n\nIl volume affronta sostenibilità integrata, energia e decarbonizzazione, gestione delle risorse, qualità ambientale interna ed economia circolare, collegando i concetti alla logica del sistema LEED.\n\nPensato per chi studia in autonomia e per professionisti dell’edilizia, propone un percorso organico per consolidare terminologia, principi e relazioni tra i diversi temi prima di affrontare la verifica finale.`,cover:cover01,amazon:"https://www.amazon.it/dp/B0HKW3673P",gallery:[photo011,photo012,photo013]},
{id:"libro-02",title:"LEED Green Associate – Workbook",description:`Il Workbook affianca lo Study Booklet trasformando i contenuti teorici in esercitazione e verifica. È progettato per allenare il ragionamento richiesto nella preparazione all’esame attraverso esercizi, quiz tematici, risposte commentate e simulazioni.\n\nLe attività aiutano a individuare gli argomenti da approfondire, riconoscere gli errori ricorrenti e verificare progressivamente il livello di preparazione.\n\nNon è una semplice raccolta di domande: è uno strumento operativo da utilizzare insieme allo Study Booklet per passare dallo studio dei concetti alla loro applicazione.`,cover:cover02,amazon:"https://www.amazon.it/Workbook-Associate-commentati-esercitazioni-simulazioni/dp/B0HK3LBHDQ",gallery:[photo021,photo022,photo023]}
];
const booksEn=booksIt.map((b,i)=>({...b,title:i===0?"LEED Green Associate – Study Booklet":"LEED Green Associate – Workbook",description:i===0?`A study manual designed to support preparation for the LEED Green Associate exam through a clear and structured overview of principles, strategies and tools for sustainable building.\n\nThe book covers integrated sustainability, energy and decarbonisation, resource management, indoor environmental quality and circular economy, connecting the topics to the logic of the LEED system.\n\nDesigned for independent learners and building professionals, it provides an organised path for consolidating terminology, principles and relationships between the main topics before final exam practice.`:`The Workbook complements the Study Booklet by turning theoretical content into practice and self-assessment. It is designed to train the reasoning used in exam preparation through exercises, thematic quizzes, commented answers and simulations.\n\nThe activities help identify topics that need further study, recognise recurring mistakes and progressively assess preparation.\n\nMore than a collection of questions, it is a practical companion to the Study Booklet, helping readers move from understanding concepts to applying them.`}));
const books=lang==="en"?booksEn:booksIt;
const t=lang==="en"?{title:"SCA Publications",intro:"Technical publications and study tools for architecture, sustainability and the built environment. The editions shown are in Italian.",amazon:"Buy on Amazon",galleryAlt:"Book preview"}:{title:"SCA Publications",intro:"Pubblicazioni tecniche e strumenti di studio per architettura, sostenibilità e ambiente costruito.",amazon:"Acquista su Amazon",galleryAlt:"Anteprima del libro"};
---
<section class="sca-books page-shell"><header class="sca-books__header"><div class="sca-books__identity"><Image src={logo} alt="SCA Publications" class="sca-books__logo" loading="eager"/><h1>{t.title}</h1></div><p>{t.intro}</p></header><div class="sca-books__list">{books.map((book,index)=><article class={`sca-book sca-book--${index===0?'study':'workbook'}`} id={book.id}><div class="sca-book__main"><div class="sca-book__cover-wrap"><img src={book.cover.src} alt={book.title} class="sca-book__cover" width={book.cover.width} height={book.cover.height} loading={index===0?'eager':'lazy'} decoding="async"/><div class="sca-book__actions">{book.amazon?<a class="sca-book__button" href={book.amazon} target="_blank" rel="noopener noreferrer">{t.amazon}</a>:<span class="sca-book__button sca-book__button--disabled" aria-disabled="true">{t.amazon}</span>}</div></div><div class="sca-book__copy"><h2>{book.title}</h2><p>{book.description}</p></div></div><div class="sca-book__gallery" aria-label={`${t.galleryAlt}: ${book.title}`}>{book.gallery.map((image,i)=><div class="sca-book__gallery-item"><Image src={image} alt={`${t.galleryAlt} ${i+1}: ${book.title}`} class="sca-book__gallery-image" widths={[480,720,1000,1400]} sizes="(max-width:760px) 100vw, 33vw" loading="lazy"/></div>)}</div></article>)}</div></section>
