---
import boscofusoLogo from "../assets/images/brand/boscofuso-logo.png";

const { lang = "it" } = Astro.props;
const base = `/${lang}`;

const content = lang === "en"
  ? {
      payoff: "Illustrated stories for little explorers and big dreamers.",
      project: "An independent Happy Edy publishing project.",
      rights: "All rights reserved.",
      privacy: "Privacy",
    }
  : {
      payoff: "Storie illustrate per piccoli esploratori e grandi sognatori.",
      project: "Un progetto editoriale indipendente Happy Edy.",
      rights: "Tutti i diritti riservati.",
      privacy: "Privacy",
    };
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a
        href={`${base}/`}
        aria-label={lang === "en" ? "Boscofuso home" : "Home Boscofuso"}
      >
        <img
          class="site-footer__logo"
          src={boscofusoLogo.src}
          alt="Boscofuso"
          loading="lazy"
        />
      </a>
      <p class="site-footer__payoff">{content.payoff}</p>
    </div>

    <div class="site-footer__project">
      <p>{content.project}</p>
      <p>© 2026 Happy Edy — {content.rights}</p>
      <a href={`${base}/privacy/`}>{content.privacy}</a>
    </div>
  </div>
</footer>
